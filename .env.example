DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/rag

# Retrieval
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-3-small
TEXT_SEARCH_CONFIG=english
RETRIEVAL_K=6
RRF_K=10
# Dense results are trusted more than lexical OR-matches; 0.4 was chosen on the
# evaluation set in scripts/evaluate.py
LEXICAL_WEIGHT=0.4

# Generation: "stub" works without a key, "openai" needs OPENAI_API_KEY
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
